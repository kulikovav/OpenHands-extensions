    {
      "id": "reviewer-request-event",
      "description": "A reviewer request selects the event trigger and filters the shared GitLab source to the configured projects, the configured reviewer request or re-request, and that reviewer's own approval.",
      "selectedTrigger": "event",
      "formValues": {
        "triggerLabel": "openhands-review",
        "triggerReviewer": "openhands-bot",
        "reviewTone": "concise",
        "on": "*",
        "projects": [
          "myorg/backend"
        ],
        "gitlabTokenSecret": "GITLAB_TOKEN_REVIEW",
        "maintainers": "alice,bob",
        "maxNewPerRun": 2,
        "gitlabApiUrl": "https://gitlab.example.com/api/v4"
      },
      "preflight": {
        "request": {
          "method": "POST",
          "path": "/v1/validate",
          "body": {
            "automationId": "gitlab-mr-reviewer",
            "endpoint": "/v1",
            "draft": {
              "name": "GitLab code review - myorg/backend",
              "trigger": {
                "type": "event",
                "on": "*",
                "source": "gitlab",
                "filter": "contains(['myorg/backend'], project.path_with_namespace) && object_kind == 'merge_request' && (contains(keys(@), 'object_attributes') && ((object_attributes.action == 'approval' || object_attributes.action == 'unapproval') && user.username == 'openhands-bot' || contains(keys(@), 'changes') && contains(keys(changes), 'reviewers') && contains(changes.reviewers[].username, 'openhands-bot')))"
              },
              "tarball_path": "oh-internal://uploads/00000000-0000-0000-0000-000000000000",
              "entrypoint": "python3 worker.py",
              "timeout": 300,
              "template": {
                "id": "gitlab-mr-reviewer",
                "version": "1.0.0",
                "config": {
                  "projects": [
                    "myorg/backend"
                  ],
                  "trigger_label": "openhands-review",
                  "trigger_reviewer": "openhands-bot",
                  "max_new_per_run": 2,
                  "review_tone": "concise",
                  "maintainers": "alice,bob",
                  "gitlab_api_url": "https://gitlab.example.com/api/v4",
                  "gitlab_token_secret": "GITLAB_TOKEN_REVIEW"
                }
              }
            }
          }
        },
        "response": {
          "status": 200,
          "body": {
            "valid": true,
            "errors": []
          }
        }
      }
